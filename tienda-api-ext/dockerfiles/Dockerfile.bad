# ============================================================
#  EJEMPLO A — Imagen NO lista para OpenShift (para el workshop)
#  Corre como root, permisos fijos, no respeta UID arbitrario
#  → Fallará con el SCC restricted-v2 de OCP 4.18
# ============================================================
FROM python:3.11-slim

# ❌ Corre como root por defecto
WORKDIR /app
COPY requirements.txt .
RUN pip install -r requirements.txt
COPY . .

# ❌ Puerto privilegiado (< 1024 requiere root o CAP_NET_BIND_SERVICE)
EXPOSE 80

# ❌ Sin USER declarado = root (uid=0)
CMD ["python", "app.py"]
